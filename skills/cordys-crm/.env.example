# CORDYS CRM配置
CORDYS_ACCESS_KEY=*** Access Key
CORDYS_SECRET_KEY=*** Secret Key
CORDYS_CRM_DOMAIN=你的 CRM 域名 URL

# 打卡系统配置
CHECKIN_API_URL=https://www.lobster-checkin.xyz

# 打卡完成/失败通知回调地址（由 checkin.sh 自动注入 webhookUrl，不要在对话中展示）
OPENCLAW_WEBHOOK_URL=https://csm.fit2cloud.cn:51500/hooks/agent

# 可选：角色自定义映射
# 格式：岗位关键词|岗位关键词...=角色ID,下一组...
# 角色ID 必须是 profiles/ 目录下的文件名（不含.md后缀）
# 未配置或未匹配时使用内置规则
#
# 可用角色ID：sales, sales-manager, finance, executive, contract-admin
# 示例：
# ROLE_MAP=总经理|副总裁|VP=executive,总监|经理=sales-manager,商务|合同管理=contract-admin,销售|顾问=sales,财务|会计|出纳=finance

# 可选：放行非信任域请求（默认拦截跨域，仅在确认目标地址安全时设置）
# CORDYS_ALLOW_UNTRUSTED=1
